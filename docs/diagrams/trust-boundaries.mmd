flowchart TB
  Public["Public clients\nreachability unknown"]
  Ingress["vps1 public boundary\nTCP 22/80/443; UDP 30326\nsource-declared"]
  AWG["AWG peer/uplink boundary\nkey material excluded"]
  Egress["vps2 egress/NAT\nsource-declared"]
  SSH["Restricted reverse-tunnel account\nremote forwarding/listeners declared"]
  Gateway["Nginx/ACME media gateway\npublic TLS boundary declared"]
  Home["server local services\n/media user-data boundary"]
  Storage["/persist, /nix, /boot\nrecovery-sensitive boundary"]
  Secrets["SOPS/private-input consumers\nvalues excluded"]
  Excluded["wsl\nexcluded legacy target"]

  Public --> Ingress
  Ingress --> AWG
  AWG --> Egress
  Ingress --> SSH
  Ingress --> Gateway
  SSH --> Home
  Gateway --> Home
  Home --> Storage
  Secrets -.-> Ingress
  Secrets -.-> Home
  Excluded -.-> Boundary["not part of supported trust model"]
